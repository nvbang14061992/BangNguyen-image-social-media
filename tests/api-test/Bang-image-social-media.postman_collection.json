				{
					"name": "log in - cookie",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const data = pm.response.json();\r",
									"\r",
									"let rawCookie = pm.cookies.get(\"authTokens\");\r",
									"\r",
									"if (rawCookie) {\r",
									"    try {\r",
									"        // Parse the JSON stored in the cookie\r",
									"        let tokens = JSON.parse(rawCookie);\r",
									"\r",
									"        // Set tokens as global variables\r",
									"        pm.globals.set(\"accessToken\", tokens.accessToken);\r",
									"        pm.globals.set(\"refreshToken\", tokens.refreshToken);\r",
									"\r",
									"        console.log(\"Tokens extracted and stored globally:\", tokens);\r",
									"    } catch (e) {\r",
									"        console.error(\"Failed to parse token cookie:\", e);\r",
									"    }\r",
									"} else {\r",
									"    console.warn(\"authTokens cookie not found\");\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
